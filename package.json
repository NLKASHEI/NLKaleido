{
  "name": "nlkaleido-reconstruction",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "ui:dev": "vite --config vite.config.ts",
    "ui:build": "vite build --config vite.config.ts",
    "ui:extension": "vite build --config vite.preview.config.ts && node scripts/package-preview.mjs",
    "check": "npm run typecheck && npm test && npm run ui:build && npm run ui:extension"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "vite": "6.3.6"
  }
}
